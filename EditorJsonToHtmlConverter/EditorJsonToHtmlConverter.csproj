<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>14.0</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>1.0.0.28</Version>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<AssemblyName>EditorJsonToHtmlConverter</AssemblyName>
		<RootNamespace>EditorJsonToHtmlConverter</RootNamespace>
		<Authors>kibblewhite &lt;kibblewhite@live.com&gt;</Authors>
		<Description>A library that can convert Editor JS JSON into HTML.</Description>
		<PackageTags>editorjs;blazor;blazor-editorjs;editorjs-blazor</PackageTags>
		<PackageIcon>editorjs.png</PackageIcon>
		<ApplicationIcon>editorjs.ico</ApplicationIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>CS1591;CA1873;</NoWarn>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
	</ItemGroup>
	
	<ItemGroup>
		<Content Include="README.md" Pack="true" PackagePath="">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="LICENSE" Pack="true" PackagePath="">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="editorjs.ico" Pack="true" PackagePath="">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="editorjs.png" Pack="true" PackagePath="">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- // The renderers' XML documentation is a runtime artefact, not just IntelliSense: consumers can reflect
	     // IBlockRenderer and read these elements to describe every supported block to tooling or a language model.
	     //
	     // Source lives under Properties\ purely for tidiness; the PackagePath is what matters. Those destination names
	     // are NOT free: NuGet auto-imports a build asset only when it is named after the package id, and the folders
	     // build\ and buildTransitive\ are well-known NuGet paths that the spec and this package's own SDK-generated
	     // *.props already spell in lower case - packing them capitalised would create a second, unrecognised folder.
	     //
	     // The XML is packed a SECOND time (it is already in lib\<tfm>\ for IntelliSense) because the official
	     // dotnet/sdk container images set NUGET_XMLDOC_MODE=skip, which makes restore discard the copy that sits beside
	     // the assembly. No framework sub-folder is used on purpose - adding one would make NuGet select that group and
	     // stop importing this package's generated static-web-assets *.props, breaking every Blazor consumer. -->
	<ItemGroup>
		<None Include="Properties\Documentation.targets" Pack="true" PackagePath="build\EditorJsonToHtmlConverter.targets" />
		<None Include="Properties\Documentation.Transitive.targets" Pack="true" PackagePath="buildTransitive\EditorJsonToHtmlConverter.targets" />
	</ItemGroup>

	<!-- // The XML copy is added at pack time rather than as a static item: $(DocumentationFile) lives under obj\, and
	     // Solution Explorer draws the folders of every evaluated item even when Visible="false", which surfaced an
	     // empty obj\Debug\<tfm>\ tree in the project. -->
	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PackEditorJsDocumentationFile</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<Target Name="_PackEditorJsDocumentationFile">
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(DocumentationFile)" PackagePath="build\EditorJsonToHtmlConverter.xml" />
		</ItemGroup>
	</Target>

</Project>
