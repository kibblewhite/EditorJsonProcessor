@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>

        @* Map tiles come from the Protomaps API on a free, non-commercial key. OpenStreetMap credit is required;
           Protomaps credit is requested. The map viewer also shows both in the corner of every map. *@
        <footer class="map-credits px-4">
            Map tiles by <a href="https://protomaps.com" target="_blank" rel="noopener">Protomaps</a>
            (free, non-commercial demo key) &middot;
            Map data &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors
        </footer>
    </main>
</div>
